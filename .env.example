# Copy to .env and fill in. Never commit .env.

# KIS Open API (real account). Market data only; the engine has no order code.
KIS_APP_KEY=
KIS_APP_SECRET=
# Defaults point at the real-account KIS servers.
# KIS_REST_URL=https://openapi.koreainvestment.com:9443
# KIS_WS_URL=ws://ops.koreainvestment.com:21000
# Mock-trading (모의투자) keys need the mock servers instead. Mock may not carry every
# real-time feed (e.g. the integrated KRX+NXT feeds); real-account keys are expected.
# KIS_REST_URL=https://openapivts.koreainvestment.com:29443
# KIS_WS_URL=ws://ops.koreainvestment.com:31000
# Daily master files of listed futures and options (nearest-month codes come from them).
# KIS_MASTER_URL=https://new.real.download.dws.co.kr/common/master

# Real-time registrations allowed per session (measured 41 on 2026-10-08 with
# `krx-quant measure-subscriptions`). Feeds beyond it fall back to REST or are skipped.
# Unset: every feed is registered until KIS refuses one.
KIS_WS_MAX_SUBSCRIPTIONS=41

# The server's Tailscale IPv4 (`tailscale ip -4`; deploy/setup-server.sh writes it). The
# engine port is published on this address only, never on the public interface.
KRX_BIND_ADDRESS=
# The host port compose publishes the Engine API on (inside the container it is 8080).
# KRX_ENGINE_PORT=8080
# Outside Docker the Engine API listens here (compose sets its own).
# KRX_API_HOST=127.0.0.1
# KRX_API_PORT=8080

# Your KIS commission per side, in percent. With the 0.20% sell tax it sets the flat band:
# moves smaller than the round-trip cost are scored as flat.
# KRX_FEE_PERCENT=0.015
# One algorithm may take this many seconds per bar close (at most 55); the algorithms'
# expected work per bar close must fit in the CPU budget, or the last registered are skipped.
# KRX_ALGORITHM_SECONDS=30
# KRX_CPU_BUDGET_SECONDS=30
# An algorithm needs this many scored predictions in a leaderboard to be ranked.
# KRX_MIN_SAMPLE=200
# The collector starts the nightly training at this time (KST) on trading days, after
# the 21:00 archive; "off" when it is trained elsewhere (EC2, #23).
# KRX_TRAIN_AT=21:30
# The collector reads the macro indicators and decides the day's regime at this time
# (KST) on trading days, after the US close; "off" to stop it.
# KRX_MACRO_AT=07:30
# Free keys of the Bank of Korea's ECOS and of FRED (docs/operations.md 2.2). A source
# without its key is skipped.
KRX_ECOS_API_KEY=
KRX_FRED_API_KEY=
# The daily regime's thresholds (docs/design.md 4.5).
# KRX_REGIME_SHOCK_SOX_PERCENT=3
# KRX_REGIME_SHOCK_VIX=30
# KRX_REGIME_SHOCK_USDKRW_PERCENT=1
# KRX_REGIME_SOX_MOVE_PERCENT=1
# KRX_REGIME_WEAK_WON_PERCENT=0.5
# Telegram signal alerts (docs/engine-api.md): "on" sends one when the final consensus is
# this sure of a move and this many active algorithms predict it. Off by default.
# KRX_SIGNAL_ALERT=off
# KRX_SIGNAL_MIN_PROBABILITY=0.6
# KRX_SIGNAL_MIN_AGREE=2

# Recorded days are archived here after the close and every night:
# s3://<bucket>/engine on the server, or a local directory.
KRX_OBJECT_STORE=
# The engine's own IAM user (deploy/create-aws.sh): this bucket only, no deletes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must be the Region the bucket was created in. Unset: AWS_DEFAULT_REGION, else ap-southeast-2.
AWS_REGION=ap-southeast-2
# For S3-compatible stores only (e.g. MinIO).
# KRX_S3_ENDPOINT_URL=

# Operational alerts (disconnects, stale feeds, failed uploads, a failed nightly training,
# model swaps, retirement candidates, server updates) go to this Telegram bot / chat.
# Leave empty to only log them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The Telegram Bot API address (tests point it at the fake KIS server).
# TELEGRAM_API_URL=https://api.telegram.org

# Local state such as the cached KIS access token (mode 600; never commit).
# KRX_STATE_DIR=state

# Comma-separated stocks to record (each takes 6 real-time registrations).
KRX_SYMBOLS=005930,000660,009150
# Sector / market index codes, US daytime tickers (NASDAQ; NYS:XYZ or AMS:XYZ for other
# exchanges), KRX-listed US ETFs (KRX-only trades over WebSocket; ETFs do not trade on NXT).
# Must include 0001 (KOSPI): circuit breakers are called from it.
# KRX_INDEX_CODES=0001,2001,0013
# KRX_US_SYMBOLS=NVDA,MU,AMD
# KRX_ETF_SYMBOLS=133690,381180
# Also record KRX-only and NXT-only trades (true/false).
# KRX_VENUE_TRADES=true
# KOSPI200 options: the ATM strike and this many strikes on each side.
# KRX_OPTION_STRIKES_EACH_SIDE=2
# Nearest futures come from the KIS master files; set these only to override.
# KRX_KOSPI200_FUTURES_CODE=
# KRX_USD_FUTURES_CODE=
# Poll intervals in seconds.
# KRX_FOREIGN_ESTIMATE_POLL_SECONDS=300
# Each symbol's VI status, from the opening auction to the close.
# KRX_VI_POLL_SECONDS=5
# KRX_FALLBACK_POLL_SECONDS=5
# REST calls per second, shared by every poll and the backfill (at most 20, the KIS limit).
# KIS_REST_MAX_PER_SECOND=20
# One-minute bars are backfilled for trading days this far back (KIS keeps about a year),
# with queries spaced evenly at this rate inside the REST limit (at most 20).
# KRX_BACKFILL_DAYS=365
# KRX_BACKFILL_MAX_PER_SECOND=8
# How often feed health (stale feeds) is checked, in seconds.
# KRX_HEALTH_CHECK_SECONDS=5
# A reconnect is announced as recovered only after staying up this long, in seconds.
# KRX_RECOVERY_HOLD_SECONDS=60
# WebSocket reconnect backoff in seconds: starts here, doubles per failed attempt, up to the max.
# KRX_RECONNECT_INITIAL_SECONDS=1
# KRX_RECONNECT_MAX_SECONDS=60
# Where Parquet files are written.
KRX_DATA_DIR=data
# A partition is written as a new part file when it reaches this many rows or seconds.
# KRX_FLUSH_ROWS=5000
# KRX_FLUSH_SECONDS=30
