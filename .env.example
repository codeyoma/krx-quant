# Copy to .env and fill in. Never commit .env.

# KIS Open API (real account). Market data only; the engine has no order code. The trader
# (`krx-quant trade`, compose service `trader`, #394) never uses these keys: in paper it places no
# order, on the collector's quotes; in mock (#405) it orders on KIS's mock server with its own keys
# below (KRX_TRADER_KIS_*); in live (#408) on the new live account with its live keys below
# (KRX_TRADER_LIVE_KIS_*) (docs/design.md 14장). KIS order code lives in the trader's
# src/krx_quant/kis_orders.py alone: the order probe (#403), the mock and live trader and the mock
# check use it.
# (바뀜 2026-10-31, #425: the mock trader alone ordered → the live trader too. 이유: #408.)
# (바뀜 2026-10-30, #422: "trades in paper only ... places no order", "for now only the order probe
# uses it" → in mock the trader orders on the mock server with its own keys. 이유: #405.)
# (바뀜 2026-10-29, #409: "the engine has no order code" → the engine has none, and the trader,
# a process of its own, trades in paper for now. 이유: 사용자가 자동 매매를 원했다(#393).)
# (바뀜 2026-10-29, #410: KIS order code was nowhere → in src/krx_quant/kis_orders.py alone, used by
# the order probe on the mock server. 이유: 주문 응답은 쓰기 전에 모의투자 서버에서 잰다(#403).)
KIS_APP_KEY=
KIS_APP_SECRET=
# Defaults point at the real-account KIS servers.
# KIS_REST_URL=https://openapi.koreainvestment.com:9443
# KIS_WS_URL=ws://ops.koreainvestment.com:21000
# Mock-trading (모의투자) keys need the mock servers instead. Mock may not carry every
# real-time feed (e.g. the integrated KRX+NXT feeds); real-account keys are expected.
# KIS_REST_URL=https://openapivts.koreainvestment.com:29443
# KIS_WS_URL=ws://ops.koreainvestment.com:31000
# Daily master files of listed futures and options (nearest-month codes come from them).
# KIS_MASTER_URL=https://new.real.download.dws.co.kr/common/master

# Real-time registrations allowed per session (measured 41 on 2026-10-08 with
# `krx-quant measure-subscriptions`). Feeds beyond it fall back to REST or are skipped.
# Unset: every feed is registered until KIS refuses one.
KIS_WS_MAX_SUBSCRIPTIONS=41

# The server's Tailscale IPv4 (`tailscale ip -4`; deploy/setup-server.sh writes it). The
# engine port is published on this address only, never on the public interface. The engine
# reads it only to mask it out of what the scheduled jobs post (#215).
KRX_BIND_ADDRESS=
# The host port compose publishes the Engine API on (inside the container it is 8080).
# KRX_ENGINE_PORT=8080
# Outside Docker the Engine API listens here (compose sets its own).
# KRX_API_HOST=127.0.0.1
# KRX_API_PORT=8080
# The collector streams 005930's best quotes to the trader on a listener of its own (#394):
# never the Engine API's port (unset: the port after KRX_API_PORT's; "off": none). Compose sets
# 0.0.0.0:8081 inside the container and publishes no port of it, so only the trader's container
# reaches it.
# KRX_QUOTES_HOST=127.0.0.1
# KRX_QUOTES_PORT=8081

# The trader (#393, #394, #395; docs/design.md 14장, docs/operations.md "자동 매매"): read by
# `krx-quant trade` alone, never by the collector. A wrong value stops the trader only.
# Its mode, set here alone (docs/operations.md "모드 바꾸기 (#405)"): paper (the default: fills
# simulated on the collector's quotes, no order) or mock (#405: the champion's trades ordered on
# KIS's mock server with KRX_TRADER_KIS_* below, its ledger written from KIS's fills; the
# challengers stay in paper) or live (#408: the champion's trades ordered on the new live account
# with KRX_TRADER_LIVE_KIS_* below, once the live gate and the execution checks pass; until then it
# runs as paper, places no order, and says what is missing on Telegram at its start and once a
# day; docs/operations.md "실전 (#408)"). With mock or live the trader does not start unless that
# mode's keys are set, are not the collector's nor the other mode's, and (mock) the servers are the
# mock ones.
# (바뀜 2026-10-30, #422: paper was the only mode, mock refused → mock orders on the mock server.
# 이유: #405.)
# (바뀜 2026-10-31, #425: live was refused → live orders on the live account past the gate and
# the checks. 이유: #408.)
# KRX_TRADER_MODE=paper
# The mock practice (#427, docs/operations.md "연습 매매 (#427)"): on, at a pick with no champion
# cell to trade (the cost map and the champion read; none passing, or none of the champion's), the
# mock book trades the practice cell one share at a time on KIS's mock server. The cell and its θ
# are frozen for each review cycle of 20 trading days (#474): the nightly job trader-report chooses
# them once a cycle (of the cells with a verdict, fail too, the greatest lower bound of the net a
# signal replayed alone), and a restart keeps them. No record, promotion, live gate or (#533) loss
# limit counts it; the risk rules and the live mode's KIS checks do. off (the default) or on; with
# KRX_TRADER_MODE=mock alone: on with paper or live stops the trader (exit 2).
# (바뀜 2026-11-05, #534: the loss limits counted it → they do not. 이유: the user's decision of
# 2026-11-04, #533: it is practice, so it may buy and sell many times.)
# (바뀜 2026-11-03, #479: the practice cell was the cost map's at each pick, the greatest lower
# bound less p*, at KRX_TRADER_THRESHOLD → the cell and θ frozen for the review cycle. 이유: spec
# #468 6 "연습", the user's choice of 2026-11-02.)
# KRX_TRADER_MOCK_PRACTICE=off
# The least minutes between two practice buys (#598, docs/operations.md "연습 매매 (#427)"): a
# practice rise buys only at a bar close this long after the bar close of the day's last practice
# buy order, else it is skipped as spacing. 15 by default, so that the day's 20 buys reach the
# afternoon and the time exits by 15:15 (on 2026-11-04 and 11-05 they were gone by 13:14 and 11:04);
# 0 spaces none. Not a risk rule: either way is allowed. The champion's cells are never spaced.
# KRX_TRADER_MOCK_PRACTICE_SPACING_MINUTES=15
# The verdict policy (#677, docs/operations.md "판정 정책 (#677)"): on a day no champion cell trades,
# the mock book also trades the engine's verdict (#676), sized by the loss budget, leaving at the
# verdict's target, stop or deadline or on a later SELL. On by default in mock mode, off in the others;
# on with paper or live is a configuration error. Its buys are spaced as the practice's.
# KRX_TRADER_MOCK_VERDICT=on
# The cells traded are picked from the Engine API's cost map (#395): those passing at a market
# order's round trip, at each start and every day at 08:30 (with the mock practice on, a day of
# none the practice cell, #427).
# (바뀜 2026-10-31, #428: a day of no passing cell traded none in every mode → with the mock
# practice on, the practice cell. 이유: since mock began on 2026-10-31 no cell passed, no KIS mock
# order went out and the live mode's execution checks never filled, #427.)
# (삭제됨 2026-10-30, #412: KRX_TRADER_KIND, KRX_TRADER_PREDICTOR, the one cell traded. 이유: the
# cost map picks the cells, spec #393. 대신: the cost map's passing cells. One still set is not
# read; the trader says so at its start.)
# The rise's probability (up, up_first), from 0 to 1, the nightly re-fit keeps on a tie. Each champion
# cell buys at the champion's θ (#399), the mock practice cell at the θ frozen for its review cycle
# (#474).
# (바뀜 2026-10-30, #414: the threshold of every cell picked → only until the first champion. 이유:
# a cell's threshold is a policy value, spec #393.)
# (바뀜 2026-11-03, #479: the mock practice cell bought at it → at the θ frozen for the review
# cycle; nothing buys at this value now. 이유: spec #468 6 "연습".)
# KRX_TRADER_THRESHOLD=0.6
# The capital in won: at most 1,000,000 (a larger value stops the trader; it narrows only). A buy
# takes what a trade's loss budget pays (below), within the cash (the capital plus the trades' net,
# #396). No policy holds it, and the nightly re-fit changes it not.
# (바뀜 2026-11-03, #478: a buy took the cell's Kelly fraction of the capital → the loss budget's
# shares. 이유: with stops a few ticks away the Kelly fraction bought the whole capital, spec #468.)
# KRX_TRADER_CAPITAL=1000000
# A trade's loss budget in percent of the capital (#471; of the live first period's cap while it
# holds): a buy takes floor(budget ÷ (best ask − stop + one tick + the commissions and the sell
# tax)) shares, none below one. Above 0 and at most 0.5: a larger value stops the trader (it narrows
# only). No policy holds it, and the nightly re-fit changes it not.
# KRX_TRADER_RISK_PER_TRADE_PERCENT=0.5
# The risk rules (#471): this many trades in a row exited at a net loss stop new buys for the
# cooldown, in minutes; at most this many buy orders a day, those refused counted (sells and cancels
# are not). Each counts from 00:00 KST, across restarts. The losses from 1 to 3 and the orders from
# 1 to 20, the cooldown 30 or more: a looser value stops the trader (they tighten only).
# KRX_TRADER_LOSS_STREAK=3
# KRX_TRADER_COOLDOWN_MINUTES=30
# KRX_TRADER_DAILY_BUY_ORDERS=20
# The loss limits in percent of the capital (#396): a day's loss (net realized plus the open
# position at the best bid) of this much sells and stops the day; a cumulative one stops the
# trader until `krx-quant trade rearm` on the server. Above 0 and at most 10 and 20: a larger value
# stops the trader (they narrow only). No policy holds them, and the nightly re-fit changes them not;
# they count the champion's trades.
# KRX_TRADER_DAILY_LOSS_PERCENT=10
# KRX_TRADER_CUMULATIVE_LOSS_PERCENT=20
# The collector's quote stream (compose sets ws://engine:8081/v1/quotes).
# KRX_TRADER_QUOTES_URL=ws://127.0.0.1:8081/v1/quotes
# The Engine API the cost map is read from (compose sets http://engine:8080, inside its network).
# KRX_TRADER_ENGINE_URL=http://127.0.0.1:8080

# Your KIS commission per side, in percent. With the 0.20% sell tax it sets the flat band:
# moves smaller than the round-trip cost are scored as flat.
# KRX_FEE_PERCENT=0.015
# One algorithm may take this many seconds per bar close (at most 55, and below the CPU
# budget); the algorithms' expected work per bar close must fit in the CPU budget, or the
# last registered are skipped.
# KRX_ALGORITHM_SECONDS=10
# KRX_CPU_BUDGET_SECONDS=30
# An algorithm needs this many scored predictions in a leaderboard to be ranked.
# KRX_MIN_SAMPLE=200
# Days on probation, and on the bench, a status is judged on, and the lift-by-day interval's
# level it needs (#87). Past the last day without becoming active: a retirement candidate.
# KRX_PROBATION_REVIEW_DAYS=10,20,40
# KRX_BENCH_REVIEW_DAYS=20,40,60
# KRX_REVIEW_CONFIDENCE=0.983
# The promotion tests the same recorded days may hold (#681): a new bar-close algorithm's
# pre-validation replay is judged for promotion at 1 - (1 - KRX_REVIEW_CONFIDENCE) / this
# (Bonferroni, 99.83% by default); with this many tests on its days already, it goes on a
# probation judged on live days instead.
# KRX_PROMOTION_BUDGET=10
# What the engine learns and forecasts (#169): 3, the only value, the touch target (#160: did
# the best bid reach the mid-point + k ticks within four minutes, else the best ask - k
# ticks), crossed quotes counted, each side a real price (#187). 2, the touch target with
# crossed quotes dropped (the default from #170 to #187), is refused: no code keeps its rule.
# The training labels, the algorithms' normal forecast and the baselines (baseline-climate
# among them) follow it, and everything is scored on it (#170).
# (삭제됨 2026-11-10, #669: KRX_TARGET_VERSION=1, the four-minute mid-point move as the target
# learned and forecast. Why: the server runs 3, and its branches were left in 14 modules; the
# user decided on 2026-11-09 to remove them. Instead: 3; 1 is refused like 2, saying what to
# set. Its stored models, predictions and answers are still read and shown.)
# KRX_TARGET_VERSION=3
# The collector starts the nightly training at this time (KST) on trading days, after
# the 21:00 archive, in its own process on this server; "off" to stop it.
# (삭제됨 2026-11-06, #572: KRX_TRAIN_ON, where the night trained, "server" or "spot" (EC2 Spot
# started by AWS at KRX_TRAIN_AT); KRX_IMAGE_REPOSITORY, the ECR repository the 06:00 update
# pushed the engine's image to for it; and the Cost Guard's KRX_COST_BUDGET,
# KRX_TRAINING_SCHEDULES, KRX_COST_CHECK_SECONDS (an AWS Budgets budget read every hour, the Spot
# schedules turned off at it). 이유: #23 계획 없음, 계정 정책이 Spot을 막음(사용자가 2026-11-05에
# 정했다). 대신: 서버 안 밤 학습, 필요하면 git 이력. One still set is not read: the night trains
# here, and no image is pushed.)
# KRX_TRAIN_AT=21:30
# Disk Watch (#379): Telegram once when less than this share (%) of the disk under the data or
# the state folder is free, and once more when it has room again; 0 turns it off.
# KRX_DISK_MIN_FREE_PERCENT=20
# The collector reads the macro indicators and decides the day's regime at this time
# (KST) on trading days, after the US close; "off" to stop it.
# KRX_MACRO_AT=07:30
# A collector running since an earlier day stops at this time on a trading day, and
# Docker starts it afresh with that day's contracts (#115); before KRX_MACRO_AT and
# 08:00, or off.
# KRX_RESTART_AT=07:20
# The engine stops once a trading day after its session and the day's review are over, from
# this time (KST), and Docker starts a fresh one before the night's training (#687). It waits
# while the archive, the training or a scheduled job runs, and gives the day up at 17:50 (the
# night futures from 18:00). From 15:50 to before 17:50, or off.
# KRX_CLOSE_RESTART_AT=17:00
# Scheduled jobs (docs/operations.md "예약 작업", #215): every night, trading day or not, from
# this time (KST; from 20:00 to before 05:30, and after KRX_TRAIN_AT; "off" to stop them),
# once the nightly training is over, the jobs due run one at a time and each result is posted
# as a comment on its GitHub issues. A job that would not end by 05:30 waits for the next night.
# A session job (#403: the order probe) runs instead in the market's hours of a trading day, at
# its time in the code; "off" stops it too.
# KRX_JOBS_AT=22:30
# The token the jobs post with, and the server snapshots below (#322): a fine-grained personal
# access token for codeyoma/krx-quant only, with Repository permissions > Issues: Read and
# write and nothing else (#218). Keep it here, never in the repository. Unset: the results stay
# in state/scheduled.json and Telegram says they were not posted; they go up at the next night
# or start once it is set. No snapshot is posted without it.
# KRX_GITHUB_TOKEN=
# The repository whose issues get the comments, and the GitHub API address (tests point it
# at a local stand-in).
# KRX_GITHUB_REPO=codeyoma/krx-quant
# KRX_GITHUB_API_URL=https://api.github.com
# Server snapshots on request (docs/operations.md "서버 상태 보기", #322): every this many minutes
# (at least 1; "off" to stop) the collector looks for the open issues labelled
# needs-server-snapshot, posts the server's summary (krx-quant doctor, masked, no market value)
# on each and removes the label. Only the label asks; an issue's text is never read. An issue
# gets one in KRX_SNAPSHOT_ISSUE_MINUTES, the server at most KRX_SNAPSHOT_PER_HOUR in any hour.
# KRX_SNAPSHOT_EVERY=3
# KRX_SNAPSHOT_ISSUE_MINUTES=10
# KRX_SNAPSHOT_PER_HOUR=6
# The economic calendar (docs/design.md 4.5, #150): read from TradingView's public feed
# every this many minutes (at least 5; "off" to stop it), for these two-letter countries.
# KRX_CALENDAR_EVERY=15
# KRX_CALENDAR_COUNTRIES=US,KR,CN,JP,EU,DE,GB
# The feed's address (tests point it at a local stand-in).
# KRX_CALENDAR_URL=https://economic-calendar.tradingview.com/events
# Free keys of the Bank of Korea's ECOS and of FRED (docs/operations.md 2.2). A source
# without its key is skipped.
KRX_ECOS_API_KEY=
KRX_FRED_API_KEY=
# The macro sources' addresses: ECOS, FRED and Yahoo Finance's chart API (tests point them at a
# local stand-in).
# KRX_ECOS_URL=https://ecos.bok.or.kr/api
# KRX_FRED_URL=https://api.stlouisfed.org
# KRX_YAHOO_URL=https://query1.finance.yahoo.com
# The Toss Securities Open API client (docs/toss-feeds.md, #235): the daily supply data's
# secondary source and the foreign holdings' primary one, and the screen's company names
# (#250). Make it in Toss's WTS under 설정 > Open API and add the server's fixed public IP to
# its allowed IPs (허용 IP 관리). Unset: nothing asks Toss (the names come from the KIS
# stock masters). Secret: keep the values here only; the scheduled jobs mask them.
# Toss keeps one valid token per client; it is cached in state/toss_token.json and shared.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# TOSS_URL=https://openapi.tossinvest.com
# The KRX Open API key (docs/krx-openapi.md, #305): the single-stock ETFs' daily net assets and
# listed units, from KRX's ETF daily trading service (ETF 일별매매정보, etf_bydd_trd). Apply at
# https://openapi.krx.co.kr: an API key (마이페이지 > API 인증키 신청), then the service
# (서비스 이용 > 증권상품 > ETF 일별매매정보 > API 이용신청); both wait for KRX's approval, and a key
# alone gets 401. Renew both yearly before they end (nothing renews itself). Non-commercial use
# only, and the data never leaves the server. Secret: keep it here only; it goes in a request
# header, and the scheduled jobs and krx-quant doctor mask it. Set: the collector fetches every
# trading day from the listing (2026-05-27) at its start and the trading day before from 08:05
# each trading morning; the closing flow reads them before KIS's. Unset: nothing asks KRX, and the net
# assets come from KIS alone. (바뀜 2026-11-04, #506: "and the scheduled probe-krx-etf-305 and
# check-krx-net-assets-305 wait" → both ran (the nights of 2026-10-23 and 10-26) and left JOBS. 이유: they
# had done their work.)
KRX_OPENAPI_KEY=
# KRX_OPENAPI_URL=https://data-dbg.krx.co.kr
# The daily regime's thresholds (docs/design.md 4.5).
# KRX_REGIME_SHOCK_SOX_PERCENT=3
# KRX_REGIME_SHOCK_VIX=30
# KRX_REGIME_SHOCK_USDKRW_PERCENT=1
# KRX_REGIME_SOX_MOVE_PERCENT=1
# KRX_REGIME_WEAK_WON_PERCENT=0.5
# Telegram signal alerts (docs/engine-api.md): "on" sends one when the final consensus is
# this sure of a move and this many active algorithms predict it, unless a VI or circuit
# breaker touches it, its bar close has no reference price, or its target time is past.
# Off by default. `krx-quant signal-review` (#206) measures candidates for the two values.
# (바뀜 2026-11-03, #483: KRX_SIGNAL_MIN_PROBABILITY's default 0.6 → 0.70, provisionally, until
# the fixed window of 20 trading days from 2026-11-04 is measured again. 이유: over 7 days, up
# signals hit 58.1% at 0.60 and 67.0% [57.7–75.1%] at 0.70. A value set here keeps its own.)
# KRX_SIGNAL_ALERT=off
# KRX_SIGNAL_MIN_PROBABILITY=0.7
# KRX_SIGNAL_MIN_AGREE=2

# Recorded days are archived here after the close and every night:
# s3://<bucket>/engine on the server, or a local directory.
KRX_OBJECT_STORE=
# The engine's own IAM user (deploy/create-aws.sh): this bucket only, no deletes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must be the Region the bucket was created in. Unset: AWS_DEFAULT_REGION, else ap-southeast-2.
AWS_REGION=ap-southeast-2
# For S3-compatible stores only (e.g. MinIO).
# KRX_S3_ENDPOINT_URL=

# Operational alerts (disconnects, stale feeds, failed uploads, a failed nightly training,
# model swaps, retirement candidates, server updates) go to this Telegram bot / chat.
# Leave empty to only log them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The Telegram Bot API address (tests point it at the fake KIS server).
# TELEGRAM_API_URL=https://api.telegram.org

# Local state such as the cached KIS access token (mode 600; never commit).
# KRX_STATE_DIR=state
# The trader's own KIS app key (#393, #403): a mock-trading (모의투자) key and its mock account,
# never the collector's KIS_APP_KEY (they would share the call limit and the token). Apply for
# 모의투자 at 한국투자증권, then issue the key for the mock account at KIS Developers
# (docs/operations.md 1장 13). The account is its 8 digits and its 2-digit product code
# (<8 digits>-<2 digits>); the HTS ID (your 한국투자증권 login) subscribes the real-time fill
# notice. Secrets: keep them here only; what the server posts masks them. Read by the order probe
# (krx-quant probe-kis-orders, run by hand: its scheduled job left in #484), which skips the fill
# notice without the HTS ID. The trader in mock mode (KRX_TRADER_MODE=mock, #405) orders with them
# through its order module (kis_orders.trader_broker, #404), and the mock day's check
# (krx-quant check-mock-trades, by hand: its scheduled job check-mock-trades-405 left JOBS in #506)
# and the fill notice layout (krx-quant fill-notice-layout, by hand: its night job
# fill-notice-layout-403 left JOBS in #580) read the day's orders with them: it refuses a key
# equal to KIS_APP_KEY and caches its token in state/trader_kis_token.json. It reads fills off the
# order inquiry, not the fill notice; with the HTS ID it records its orders' fill notices in
# state/fill_notices.sqlite3 to be measured (#484), and without it records none (the trading is
# the same).
# KRX_TRADER_KIS_APP_KEY=
# KRX_TRADER_KIS_APP_SECRET=
# KRX_TRADER_KIS_ACCOUNT=
# KRX_TRADER_KIS_HTS_ID=
# The servers the trader calls: the mock ones unless set. The order probe and the trader's mock
# order module refuse any other (the live account has keys of its own, below).
# KRX_TRADER_KIS_REST_URL=https://openapivts.koreainvestment.com:29443
# KRX_TRADER_KIS_WS_URL=ws://ops.koreainvestment.com:31000
# The trader's live keys (#408, docs/operations.md 1장 14): the new live account's own app key, app
# secret and account (<8 digits>-<2 digits>), that account holding the operating cap alone, its
# margin rate set to 100% (no credit). Read by the live mode alone (KRX_TRADER_MODE=live,
# kis_orders.trader_live_broker), on KIS's live servers, which no setting changes; named apart from
# the mock keys above, so that neither the mock mode nor the order probe ever reads them (both
# refuse a mock key or account equal to these). The live mode does not start without them, or with
# a key equal to KIS_APP_KEY or the mock key; its token is cached in
# state/trader_live_kis_token.json. Secrets: keep them here only; what the server posts masks them.
# KRX_TRADER_LIVE_KIS_APP_KEY=
# KRX_TRADER_LIVE_KIS_APP_SECRET=
# KRX_TRADER_LIVE_KIS_ACCOUNT=
# Every process's log lines go to stdout (docker compose logs, until the next deploy) and, with
# these three set, masked to Grafana Cloud Loki, where they are kept and agents query them (#358,
# docs/operations.md "Grafana Cloud Loki로 보내는 로그"): the stack's Loki address
# (https://logs-prod-<n>.grafana.net; the push path /loki/api/v1/push is added), its user ID and
# a logs:write access policy token (a secret). All three, or nothing is sent. Keep the real
# address and user ID here and on the Mac only, never in the repo. (KRX_LOG_DAYS and
# KRX_LOG_MAX_MB, the files under state/logs, went in #360: delete them from .env.)
# KRX_LOKI_URL=https://logs-prod-<n>.grafana.net
# KRX_LOKI_USER=
# KRX_LOKI_TOKEN=

# Comma-separated stocks to record (each takes 6 real-time registrations).
KRX_SYMBOLS=005930,000660,009150
# Sector / market index codes, US daytime tickers (NASDAQ; NYS:XYZ or AMS:XYZ for other
# exchanges), KRX-listed US ETFs (KRX-only trades over WebSocket; ETFs do not trade on NXT).
# Must include 0001 (KOSPI): circuit breakers are called from it.
# KRX_INDEX_CODES=0001,2001,0013
# KRX_US_SYMBOLS=NVDA,MU,AMD
# KRX_ETF_SYMBOLS=133690,381180
# Also record KRX-only and NXT-only trades (true/false). Shannon's NXT share of the volume
# needs both; without them it is unknown.
# KRX_VENUE_TRADES=true
# KOSPI200 options: the ATM strike and this many strikes on each side.
# KRX_OPTION_STRIKES_EACH_SIDE=2
# Nearest futures come from the KIS master files; set these only to override.
# KRX_KOSPI200_FUTURES_CODE=
# KRX_USD_FUTURES_CODE=
# Poll intervals in seconds.
# The investor estimates, asked from the open to the close of a trading day only.
# KRX_FOREIGN_ESTIMATE_POLL_SECONDS=300
# Each symbol's VI status, from the opening auction to the close.
# KRX_VI_POLL_SECONDS=5
# KRX_FALLBACK_POLL_SECONDS=5
# REST calls per second, shared by every poll and the backfill (at most 20, the KIS limit).
# KIS_REST_MAX_PER_SECOND=20
# One-minute bars are backfilled for trading days this far back (KIS keeps about a year),
# with queries spaced evenly at this rate inside the REST limit (at most 20).
# KRX_BACKFILL_DAYS=365
# KRX_BACKFILL_MAX_PER_SECOND=8
# How often feed health (stale feeds) is checked, in seconds.
# KRX_HEALTH_CHECK_SECONDS=5
# A reconnect is announced as recovered only after staying up this long, in seconds. Only a
# drop that was alerted is: one back within 30 s sends neither alert.
# KRX_RECOVERY_HOLD_SECONDS=60
# WebSocket reconnect backoff in seconds: starts here, doubles per failed attempt, up to the max.
# KRX_RECONNECT_INITIAL_SECONDS=1
# KRX_RECONNECT_MAX_SECONDS=60
# A KIS WebSocket that delivers no frame at all (no data, no PINGPONG, no reply) for this many
# seconds is taken as dead, closed and reconnected. At least 20: KIS sends a PINGPONG about
# every 10.8 s while nothing else flows.
# KRX_WS_SILENCE_SECONDS=60
# Where Parquet files are written.
KRX_DATA_DIR=data
# A partition is written as a new part file when it reaches this many rows or seconds.
# KRX_FLUSH_ROWS=5000
# KRX_FLUSH_SECONDS=30
